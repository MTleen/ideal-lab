{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ideal-agent-loop/profile-v1",
  "title": "Loop Profile v1",
  "type": "object",
  "required": [
    "schema",
    "id",
    "phases",
    "capabilities",
    "policies"
  ],
  "properties": {
    "schema": {
      "const": "ideal-agent-loop/profile-v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "planner",
          "requires",
          "gate",
          "tasks"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "planner": {
            "enum": [
              "declared",
              "dynamic"
            ]
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "gate": {
            "type": "string"
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "role",
                "capability",
                "depends_on",
                "produces"
              ]
            }
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "inputs",
          "outputs",
          "permissions"
        ]
      }
    },
    "policies": {
      "type": "object",
      "required": [
        "retry",
        "review",
        "permissions"
      ]
    }
  },
  "additionalProperties": true
}
